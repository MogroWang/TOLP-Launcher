{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TOLP-Launcher",
  "mainBinaryName": "TOLP-Launcher",
  "version": "0.2.0",
  "identifier": "com.mogrowangstudio.tolp.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TOLP 启动器 · 光点之旅",
        "width": 1120,
        "height": 700,
        "minWidth": 920,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
